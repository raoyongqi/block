
{
    "manifest_version": 2,
    "name": "Request Domain Tracker",
    "version": "1.0",
    "description": "record requests",
    "permissions": [
    "activeTab", "scripting","storage",      "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
    ],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "background": {
      "scripts": ["background.js"]
    },
    "browser_action": {
      "default_title": "Read requests",
      "default_popup": "popup.html",
      "default_icon": {
        "16": "spider_web.png",
        "48": "spider_web.png",
        "128": "spider_web.png"
      }
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "addons-my-new-addon@mozilla.com",
    
            "strict_min_version": "54.0a1"
        }}
  }
  