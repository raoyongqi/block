
{
    "manifest_version": 2,
    "name": "Request Domain Tracker",
    "version": "1.0",
    "description": "record requests",
    "permissions": [
      "tabs",
      "webRequest",
      "webRequestBlocking",
      "<all_urls>",
      "storage"
    ],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "background": {
      "scripts": ["background.js"]
    },
    "browser_action": {
      "default_title": "Read requests",
      "default_popup": "popup.html"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "raoyongqi@domain-tracker1.io",
    
            "strict_min_version": "54.0a1"
        }}
  }
  