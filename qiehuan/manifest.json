{
    "manifest_version": 2,
    "name": "Background Color Switcher",
    "version": "1.0",
    "description": "Click to toggle background color",
    "permissions": ["activeTab", "scripting","storage",      "tabs",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"],
    "browser_action": {
      "default_popup": "popup.html"

    },
    "background": {
      "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file:///*",
        "*://*/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
    "browser_specific_settings": {
      "gecko": {
          "id": "addons-my-new-addon@qiehuan.com",
  
          "strict_min_version": "54.0a1"
      }
  }
  }
  